# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store

# Готові APK в корені проєкту (для зручної установки) — не комітяться,
# легко перезібрати командою `flutter build apk --release`
/*.apk
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
android/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release-підпис — секрети, ніколи не в git. Без цих файлів release-збірка
# автоматично відкочується на дебаг-підпис (build.gradle.kts перевіряє
# наявність key.properties).
android/key.properties
android/app/*.jks
android/app/*.keystore

# Готові збірки під кожну ОС (builds/android/, builds/iphone/) — самі
# бінарники (APK/IPA) не комітяться, легко перезібрати; інструкції
# встановлення (.md) поруч — звичайні текстові файли, лишаються в git.
builds/**/*.apk
builds/**/*.ipa
builds/**/*.aab
